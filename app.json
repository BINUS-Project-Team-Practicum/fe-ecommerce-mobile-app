{
  "expo": {
    "name": "Binus Marketplace",
    "slug": "bion-tk-marketplace",
    "scheme": "binus-marketplace",
    "icon": "./src/public/binus-marketplace-app-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/public/binus-marketplace-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0CC7A4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ardanimith.ecommercemarketplace"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/public/binus-marketplace-app-icon.png",
        "backgroundColor": "#061938"
      },
      "package": "com.ardanimith.ecommercemarketplace"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "aa3000f6-71f2-4226-bc79-138b70529f8d"
      }
    },
    "owner": "loenk2xs-team"
  }
}
